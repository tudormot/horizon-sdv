+async fn send_fake_speed_limit_data(context: ContextRef) -> anyhow::Result<()> {
+    let mw_comms = SdvComms { context };
+
+    let display_limit_pub = create_publisher(
+        &mw_comms,
+        &PublisherDescriptorFull::<TellTaleStatus>::new(DS_SHOULD_DISPLAY_SPEED_LIMIT_TOPIC),
+    )
+    .await?;
+
+    let limit_value_pub = create_publisher(
+        &mw_comms,
+        &PublisherDescriptorFull::<VehicleSpeed>::new(DS_SPEED_LIMIT_TOPIC),
+    )
+    .await?;
+
+    let speeds = [35, 45, 55, 65];
+    let mut speed_value: u32 = speeds[rand::thread_rng().gen_range(0..speeds.len())];
+    let mut ticks_until_switch: u32 = rand::thread_rng().gen_range(20..=40);
+
+    let mut interval = tokio::time::interval(Duration::from_secs(1));
+    interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        interval.tick().await;
+
+        let data = VehicleSpeed {
+            speed: speed_value,
+            precise_speed: speed_value as f32,
+            ..Default::default()
+        };
+        limit_value_pub.publish(&data).map_err(|e| anyhow!("Failed to write message: {}", e))?;
+
+        let should_display_data = TellTaleStatus { alert: true, ..Default::default() };
+        display_limit_pub
+            .publish(&should_display_data)
+            .map_err(|e| anyhow!("Failed to write message: {}", e))?;
+
+        info!("Published speed limit data: {:?}", data);
+
+        ticks_until_switch = ticks_until_switch.saturating_sub(1);
+        if ticks_until_switch == 0 {
+            speed_value = speeds[rand::thread_rng().gen_range(0..speeds.len())];
+            ticks_until_switch = rand::thread_rng().gen_range(20..=40);
+        }
+    }
+}
