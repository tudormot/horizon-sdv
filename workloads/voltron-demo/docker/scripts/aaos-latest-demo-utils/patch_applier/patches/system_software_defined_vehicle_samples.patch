+/// In addition to listening to Carla Sim Gnss data publication,
+/// Carla client publishes some fake Gnss data itself. This allows
+/// development of downstream data consumers, without bringing up
+/// the full carla simulator setup
+async fn send_fake_gnss_data(context: ContextRef) -> anyhow::Result<()> {
+    let mw_comms = SdvComms { context };
+
+    let publisher = create_publisher(
+        &mw_comms,
+        &PublisherDescriptorFull::<CarlaVehicleGnssData>::new(CARLA_GNSS_DATA_TOPIC),
+    )
+    .await?;
+
+    let mut latitude = GOOGLEPLEX_LAT;
+    let mut longitude = GOOGLEPLEX_LON;
+
+    let mut interval = tokio::time::interval(Duration::from_secs(1));
+    interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        interval.tick().await;
+
+        let data = CarlaVehicleGnssData { latitude, longitude, ..Default::default() };
+        publisher.publish(&data).map_err(|e| anyhow!("Failed to write message: {}", e))?;
+
+        info!("Published GNSS data: {:?}", data);
+
+        latitude += 0.0001;
+        longitude += 0.0001;
+    }
+}
