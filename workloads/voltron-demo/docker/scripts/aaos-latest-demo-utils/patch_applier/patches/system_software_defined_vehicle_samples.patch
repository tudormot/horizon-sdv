+/// Waits for topic to become available(occurs only when first publisher registers on topic),
+/// then subscribes to data sent on topic. Returns a stream of data sent on topic
+async fn get_topic_stream<M: MessageFull>(
+    context: ContextRef,
+    topic: &str,
+) -> SdvResult<impl Stream<Item = SdvResult<M>> + Send> {
+    let mw_comms = SdvComms { context };
+    let sub_descriptor = SubscriberDescriptorFull::new(topic);
+
+    create_registration_event_stream(&mw_comms, &sub_descriptor)
+        .await?
+        .filter(|e| future::ready(matches!(e, &Availability::Available)))
+        .pipe(Box::pin)
+        .next()
+        .await
+        .ok_or(Err(SdvStatus::with_message(
+            SdvStatusCode::Unknown,
+            "Availability stream unexpectedly closed".to_string(),
+        )))?;
+
+    create_observer(&mw_comms, &sub_descriptor, &SubscribeOptions::default())
+        .await?
+        .pipe(flatten_mw)
         .pipe(Ok)
 }
