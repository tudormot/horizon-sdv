+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+syntax = "proto3";
+
+package com.sdv.google.display_safety;
+import "sdv/vsidl/v1/annotations.proto";
+
+message VehicleSpeed {
+    option (.sdv.vsidl.v1.publication) = {
+        // Expected speed topic updates are around 50Hz
+        // Set the buffer size to 2X the message per second.
+        message_count: 100
+        model: MULTI_PUB
+    };
+    uint32 speed = 1;
+    float precise_speed = 2;
+}
+
+// Alert type telltales
+message TellTaleStatus {
+    option (.sdv.vsidl.v1.publication) = {
+        message_count: 8
+        model: MULTI_PUB
+    };
+  bool alert = 1;
+}
+
+enum Gear {
+    P = 0;
+    R = 1;
+    N = 2;
+    D = 3;
+}
+
+message CurrentGear {
+    option (.sdv.vsidl.v1.publication) = {
+        message_count: 8
+        model: MULTI_PUB
+    };
+    Gear gear = 1;
+}
+
+// RPM
+message EngineRpm {
+    option (.sdv.vsidl.v1.publication) = {
+        message_count: 100
+        model: MULTI_PUB
+    };
+    uint32 rpm = 1;
+}
+
+// Remaining range of the vehicle in distance units.
+message RangeRemaining {
+    option (.sdv.vsidl.v1.publication) = {
+        message_count: 8
+        model: MULTI_PUB
+    };
+    float remaining_range = 1;
+}
+
+enum AdasObjectState {
+    ADAS_OBJECT_STATE_NORMAL = 0;
+    ADAS_OBJECT_STATE_LEAD = 1;
+    ADAS_OBJECT_STATE_WARNING = 2;
+    ADAS_OBJECT_STATE_IN_BLINDSPOT_LEFT = 3;
+    ADAS_OBJECT_STATE_IN_BLINDSPOT_RIGHT = 4;
+}
+
+message AdasObject {
+    uint64 id = 1;
+    string class_tag = 2;
+    AdasObjectState state = 3;
+    float position_x = 4;
+    float position_y = 5;
+    float position_z = 6;
+    float heading_rad = 7;
+    float confidence = 8;
+}
+
+enum AdasSplineState {
+    ADAS_SPLINE_STATE_NORMAL = 0;
+    ADAS_SPLINE_STATE_ACTIVE = 1;
+    ADAS_SPLINE_STATE_WARNING = 2;
+}
+
+enum AdasLineType {
+    ADAS_LINE_TYPE_SOLID = 0;
+    ADAS_LINE_TYPE_DASHED = 1;
+    ADAS_LINE_TYPE_DOUBLE_SOLID = 2;
+    ADAS_LINE_TYPE_BOTTS_DOTS = 3;
+}
+
+message Point2D {
+    float x = 1;
+    float y = 2;
+}
+
+message AdasSpline {
+    uint32 id = 1;
+    string semantic_tag = 2;
+    AdasSplineState state = 3;
+    AdasLineType line_type = 4;
+    uint32 dash_length = 5;
+    repeated Point2D points = 6;
+    float width = 7;
+}
+
+message AdasLaneSurface {
+    uint32 id = 1;
+    repeated Point2D left_points = 2;
+    repeated Point2D right_points = 3;
+    bool is_active = 4;
+}
+
+enum LateralControlState {
+    LATERAL_CONTROL_STATE_UNAVAILABLE = 0;
+    LATERAL_CONTROL_STATE_AVAILABLE = 1;
+    LATERAL_CONTROL_STATE_ENGAGED = 2;
+}
+
+message AdasSystemState {
+    LateralControlState lateral_control_state = 1;
+}
+
+message AdasParkingSensors {
+    repeated float front_sensors = 1;
+    repeated float rear_sensors = 2;
+}
