+
+// Global (SDV VM instance) orchestration configurations.
+// Path to file must be set with the `persist.sdv.orchestrator_config_path`
+// system property.
+// The `persist.sdv.orchestrator_config_path` system property specifies the path
+// to the VM-level orchestration configuration file. Since this property can only
+// point to a single file, if multiple VM-level configurations are autogenerated
+// (e.g. from different catalogs), their contents must be merged into one file.
+prebuilt_etc {
+    name: "com_android_sdv_sample_gapb_orchestration_configurations",
+    srcs: [
+        // Configuration to start service bundles on boot.
+        "vm_gapb_orch_config.textproto",
+    ],
+    // Subdirectory under which the file(s) to be installed into.
+    sub_dir: "orch",
+}
