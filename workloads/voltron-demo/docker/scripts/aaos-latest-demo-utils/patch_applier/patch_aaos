"""Patch Applier script for AAOS workspace repositories.

Reads a JSON config manifest specifying patches, expected base commit SHAs,
and target repository paths, and applies patches cleanly.
"""

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import subprocess
import sys
from typing import Any, List, Optional


@dataclass
class PatchTask:
    """Represents a validated patch application task."""

    patch_file: Path
    repo_dir: Path
    expected_commit: str
    repo_rel: str


def log_error(msg: str) -> None:
    """Prints diagnostic error message to stderr."""
    sys.stderr.write(f"ERROR: {msg}\n")


def log_info(msg: str) -> None:
    """Prints progress message to stdout."""
    sys.stdout.write(f"[PATCH-AAOS] {msg}\n")


def get_git_head_commit(repo_dir: Path) -> str:
    """Returns current git HEAD commit SHA for repo_dir."""
    try:
        res = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=repo_dir,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        return res.stdout.strip()
    except subprocess.CalledProcessError as err:
        stderr_text = err.stderr.strip() if err.stderr else str(err)
        raise RuntimeError(
            f"Failed to query git HEAD commit in '{repo_dir}': {stderr_text}"
        ) from err


def is_git_patch_applied(repo_dir: Path, patch_file: Path) -> bool:
    """Checks if a patch is already applied to repo_dir using git apply --reverse --check."""
    res = subprocess.run(
        ["git", "apply", "--reverse", "--check", str(patch_file)],
        cwd=repo_dir,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return res.returncode == 0


def apply_git_patch(repo_dir: Path, patch_file: Path) -> None:
    """Applies a patch file to repo_dir using git apply."""
    try:
        subprocess.run(
            ["git", "apply", str(patch_file)],
            cwd=repo_dir,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except subprocess.CalledProcessError as err:
        stderr_text = err.stderr.strip() if err.stderr else str(err)
        raise RuntimeError(
            f"Failed to apply patch '{patch_file}' to '{repo_dir}':\n{stderr_text}"
        ) from err


def parse_args() -> argparse.Namespace:
    """Parses and returns command line arguments."""
    parser = argparse.ArgumentParser(
        description="Applies diff patches to AAOS repositories after commit verification."
    )
    parser.add_argument(
        "aaos_dir_pos",
        nargs="?",
        help="Path to AAOS root deployment directory.",
    )
    parser.add_argument(
        "--aaos-dir",
        "-d",
        dest="aaos_dir_flag",
        help="Path to AAOS root deployment directory.",
    )
    parser.add_argument(
        "--config",
        "-c",
        help="Path to patches JSON manifest file (default: patches.json relative to script).",
    )
    return parser.parse_args()


def load_manifest(config_file: Path) -> Optional[List[Any]]:
    """Loads and returns the JSON manifest from the specified configuration file."""
    if not config_file.is_file():
        log_error(f"Patch manifest JSON file '{config_file}' not found.")
        return None

    log_info(f"Loading patch manifest: {config_file}")
    try:
        with open(config_file, "r", encoding="utf-8") as file_handle:
            manifest = json.load(file_handle)
    except (json.JSONDecodeError, OSError) as err:
        log_error(f"Failed to parse JSON manifest '{config_file}': {err}")
        return None

    if not isinstance(manifest, list):
        log_error(f"Invalid manifest format in '{config_file}': Expected a JSON array.")
        return None

    return manifest


def validate_manifest(
    manifest: List[Any], config_file: Path, aaos_dir: Path
) -> Optional[List[PatchTask]]:
    """Validates manifest entries and returns a list of PatchTasks, or None on failure."""
    validated_tasks: List[PatchTask] = []
    for idx, entry in enumerate(manifest):
        if not isinstance(entry, dict):
            log_error(f"Manifest entry #{idx+1} is not a valid JSON object.")
            return None

        patch_rel = entry.get("patch_filename")
        repo_rel = entry.get("repo_path")
        expected_commit = entry.get("expected_base_commit")

        if not patch_rel or not repo_rel or not expected_commit:
            log_error(
                f"Manifest entry #{idx+1} is missing required fields "
                "('patch_filename', 'repo_path', 'expected_base_commit')."
            )
            return None

        patch_file = Path(patch_rel)
        if not patch_file.is_absolute():
            patch_file = (config_file.parent / patch_file).resolve()

        if not patch_file.is_file():
            log_error(
                f"Patch file '{patch_file}' specified for entry #{idx+1} does not exist."
            )
            return None

        repo_dir = (aaos_dir / repo_rel).resolve()
        if not repo_dir.is_dir():
            log_error(
                f"Target repository directory '{repo_dir}' does not exist under '{aaos_dir}'."
            )
            return None

        validated_tasks.append(
            PatchTask(
                patch_file=patch_file,
                repo_dir=repo_dir,
                expected_commit=expected_commit,
                repo_rel=repo_rel,
            )
        )
    return validated_tasks


def process_patch_task(task: PatchTask) -> bool:
    """Verifies commit SHA and applies a single patch task. Returns True on success."""
    log_info(f"Processing repository: {task.repo_rel}")
    try:
        actual_commit = get_git_head_commit(task.repo_dir)
    except RuntimeError as err:
        log_error(str(err))
        return False

    if not actual_commit.startswith(
        task.expected_commit
    ) and not task.expected_commit.startswith(actual_commit):
        log_error(
            f"Commit SHA mismatch in repository '{task.repo_rel}'!\n"
            f"  Expected commit: {task.expected_commit}\n"
            f"  Actual HEAD:     {actual_commit}\n"
            f"Refusing to apply patch '{task.patch_file.name}' due to commit mismatch."
        )
        return False

    if is_git_patch_applied(task.repo_dir, task.patch_file):
        log_info(
            f"Patch '{task.patch_file.name}' is already applied to '{task.repo_rel}'. Skipping."
        )
        return True

    log_info(
        f"HEAD commit matches expected '{task.expected_commit[:10]}'. "
        f"Applying patch '{task.patch_file.name}'..."
    )
    try:
        apply_git_patch(task.repo_dir, task.patch_file)
    except RuntimeError as err:
        log_error(str(err))
        return False

    log_info(f"Successfully applied '{task.patch_file.name}' to '{task.repo_rel}'.")
    return True


def main() -> int:
    """Main entry point for patch_aaos."""
    args = parse_args()
    aaos_dir_str = args.aaos_dir_flag or args.aaos_dir_pos
    if not aaos_dir_str:
        log_error("AAOS root directory must be specified via argument or --aaos-dir.")
        return 1

    aaos_dir = Path(os.path.expanduser(aaos_dir_str)).resolve()
    if not aaos_dir.is_dir():
        log_error(
            f"AAOS root directory '{aaos_dir}' does not exist or is not a directory."
        )
        return 1

    script_dir = Path(__file__).parent.resolve()
    config_path_str = args.config or str(script_dir / "patches.json")
    config_file = Path(os.path.expanduser(config_path_str)).resolve()

    manifest = load_manifest(config_file)
    if manifest is None:
        return 1

    tasks = validate_manifest(manifest, config_file, aaos_dir)
    if tasks is None:
        return 1

    log_info(
        f"Verified {len(tasks)} patch entries. Validating commit SHAs and applying..."
    )
    for task in tasks:
        if not process_patch_task(task):
            return 1

    log_info("All patches applied successfully!")
    return 0


if __name__ == "__main__":
    sys.exit(main())
